<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<script>
    // API BASE - Update this to match your backend URL
    const API_BASE = "https://localhost:7184/api/";
    let AUTH_TOKEN = localStorage.getItem("admin_token") || null;
    let currentMessageId = null;
    
    // Arrays to store items
    let currentSkills = [];
    let currentFeatures = [];
    let currentBulletPoints = [];

    // Initialize smooth scroll
    const lenis = new Lenis({ duration: 1.2, smoothWheel: true });
    function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);
    AOS.init({ duration: 600, once: true });

    // Helper fetch with auth
    async function apiFetch(endpoint, options = {}) {
        const headers = { "Content-Type": "application/json", ...options.headers };
        if (AUTH_TOKEN) headers["Authorization"] = `Bearer ${AUTH_TOKEN}`;
        
        if (options.body instanceof FormData) {
            delete headers["Content-Type"];
        }
        
        const config = { ...options, headers };
        const res = await fetch(`${API_BASE}${endpoint}`, config);
        if (res.status === 401) { logout(); throw new Error("Unauthorized"); }
        return res;
    }

    function showToast(msg, type = "success") {
        const toastContainer = document.getElementById("toastContainer") || (() => {
            let c = document.createElement("div");
            c.className = "toast-container position-fixed bottom-0 end-0 p-3";
            c.id = "toastContainer";
            document.body.appendChild(c);
            return c;
        })();
        
        const toastHtml = `<div class="toast align-items-center text-bg-${type} border-0" role="alert" data-bs-autohide="true" data-bs-delay="3000">
            <div class="d-flex">
                <div class="toast-body">${msg}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>`;
        
        const toastEl = document.createElement("div");
        toastEl.innerHTML = toastHtml;
        toastContainer.appendChild(toastEl);
        const bsToast = new bootstrap.Toast(toastEl.querySelector(".toast"));
        bsToast.show();
        toastEl.addEventListener("hidden.bs.toast", () => toastEl.remove());
    }

    function previewImage(input, previewId) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById(previewId).innerHTML = `<img src="${e.target.result}" class="image-upload-preview" alt="Preview">`;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Skill Management
    function renderSkills() {
        const container = document.getElementById('skillsList');
        if (!container) return;
        
        if (currentSkills.length === 0) {
            container.innerHTML = '<div class="text-muted small mb-2">No skills added yet</div>';
            return;
        }
        
        container.innerHTML = currentSkills.map((skill, index) => `
            <div class="list-item">
                <span>${escapeHtml(skill)}</span>
                <button type="button" class="btn-remove-item" onclick="removeSkill(${index})">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        `).join('');
    }
    
    function addSkill() {
        const input = document.getElementById('newSkillInput');
        const skill = input.value.trim();
        if (skill) {
            currentSkills.push(skill);
            renderSkills();
            input.value = '';
        }
    }
    
    function removeSkill(index) {
        currentSkills.splice(index, 1);
        renderSkills();
    }
    
    // Feature Management
    function renderFeatures() {
        const container = document.getElementById('featuresList');
        if (!container) return;
        
        if (currentFeatures.length === 0) {
            container.innerHTML = '<div class="text-muted small mb-2">No features added yet</div>';
            return;
        }
        
        container.innerHTML = currentFeatures.map((feature, index) => `
            <div class="list-item">
                <span>${escapeHtml(feature)}</span>
                <button type="button" class="btn-remove-item" onclick="removeFeature(${index})">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        `).join('');
    }
    
    function addFeature() {
        const input = document.getElementById('newFeatureInput');
        const feature = input.value.trim();
        if (feature) {
            currentFeatures.push(feature);
            renderFeatures();
            input.value = '';
        }
    }
    
    function removeFeature(index) {
        currentFeatures.splice(index, 1);
        renderFeatures();
    }
    
    // Bullet Point Management
    function renderBulletPoints() {
        const container = document.getElementById('bulletPointsList');
        if (!container) return;
        
        if (currentBulletPoints.length === 0) {
            container.innerHTML = '<div class="text-muted small mb-2">No bullet points added yet</div>';
            return;
        }
        
        container.innerHTML = currentBulletPoints.map((point, index) => `
            <div class="list-item">
                <span>${escapeHtml(point)}</span>
                <button type="button" class="btn-remove-item" onclick="removeBulletPoint(${index})">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        `).join('');
    }
    
    function addBulletPoint() {
        const input = document.getElementById('newBulletPointInput');
        const point = input.value.trim();
        if (point) {
            currentBulletPoints.push(point);
            renderBulletPoints();
            input.value = '';
        }
    }
    
    function removeBulletPoint(index) {
        currentBulletPoints.splice(index, 1);
        renderBulletPoints();
    }

    // Login Logic
    document.getElementById("loginForm")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const username = document.getElementById("username").value;
        const password = document.getElementById("password").value;
        const btn = document.getElementById("loginBtn");
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Logging...';
        
        try {
            const res = await fetch(`${API_BASE}Auth/login`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || "Invalid credentials");
            
            AUTH_TOKEN = data.token;
            localStorage.setItem("admin_token", AUTH_TOKEN);
            showToast("Login successful!", "success");
            document.getElementById("loginPage").style.display = "none";
            document.getElementById("dashboardWrapper").style.display = "block";
            gsap.from(".dashboard-wrapper", { opacity: 0, duration: 0.8, ease: "power2.out" });
            loadDashboardContent("projects");
        } catch (err) {
            showToast(err.message, "danger");
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-2"></i> Login';
        }
    });

    function logout() {
        localStorage.removeItem("admin_token");
        AUTH_TOKEN = null;
        location.reload();
    }
    document.getElementById("logoutButton")?.addEventListener("click", logout);

    // Dashboard sections
    const sections = {
        projects: "projectsSection",
        experiences: "experiencesSection",
        testimonials: "testimonialsSection",
        messages: "messagesSection"
    };
    
    document.querySelectorAll(".nav-link").forEach(link => {
        link.addEventListener("click", (e) => {
            e.preventDefault();
            const section = link.dataset.section;
            document.querySelectorAll(".nav-link").forEach(l => l.classList.remove("active"));
            link.classList.add("active");
            Object.values(sections).forEach(sec => document.getElementById(sec).style.display = "none");
            document.getElementById(sections[section]).style.display = "block";
            document.getElementById("sectionTitle").innerHTML = link.innerHTML;
            loadDashboardContent(section);
            if (window.innerWidth < 992) {
                document.getElementById("sidebar").classList.remove("open");
                document.getElementById("mobileOverlay").classList.remove("show");
            }
        });
    });
    
    document.getElementById("menuToggle")?.addEventListener("click", () => {
        document.getElementById("sidebar").classList.toggle("open");
        document.getElementById("mobileOverlay").classList.toggle("show");
    });
    
    document.getElementById("mobileOverlay")?.addEventListener("click", () => {
        document.getElementById("sidebar").classList.remove("open");
        document.getElementById("mobileOverlay").classList.remove("show");
    });

    async function loadDashboardContent(section) {
        if (section === "projects") await loadProjects();
        else if (section === "experiences") await loadExperiences();
        else if (section === "testimonials") await loadTestimonials();
        else if (section === "messages") await loadMessages();
    }

    // PROJECTS CRUD
    async function loadProjects() {
        try {
            const res = await apiFetch("Projects");
            if (!res.ok) throw new Error("Failed to load projects");
            const projects = await res.json();
            const container = document.getElementById("projectsList");
            
            if (projects.length === 0) {
                container.innerHTML = `<div class="col-12 text-center py-5"><i class="bi bi-folder2-open fs-1 text-muted"></i><p class="text-muted mt-2">No projects yet. Click "New Project" to add one.</p></div>`;
                return;
            }
            
            container.innerHTML = projects.map(p => `
                <div class="col-md-6 col-lg-4 mb-4" data-aos="fade-up">
                    <div class="card-dashboard card h-100 p-3">
                        ${p.imageUrl ? `<img src="${p.imageUrl}" class="card-img-top rounded-3 mb-2" style="height:200px;object-fit:cover;" onerror="this.src='https://via.placeholder.com/200?text=No+Image'">` : `<div class="bg-light rounded-3 text-center py-5 mb-2"><i class="bi bi-image fs-1 text-muted"></i></div>`}
                        <div class="card-body">
                            <h5 class="fw-bold">${escapeHtml(p.name)}</h5>
                            <div class="mb-2">
                                ${p.skills && p.skills.length > 0 ? p.skills.map(skill => `<span class="skill-tag">${escapeHtml(skill)}</span>`).join(' ') : '<span class="text-muted">No skills listed</span>'}
                            </div>
                            ${p.features && p.features.length > 0 ? `
                                <div class="mb-2">
                                    <small class="text-muted fw-semibold">Features:</small><br>
                                    ${p.features.map(f => `<span class="feature-tag">${escapeHtml(f)}</span>`).join(' ')}
                                </div>
                            ` : ''}
                            <p class="text-muted small mt-2">${escapeHtml(p.description?.substring(0, 100))}${p.description?.length > 100 ? '...' : ''}</p>
                            <div class="mt-2">
                                ${p.githubLink ? `<a href="${p.githubLink}" target="_blank" class="text-decoration-none me-2 small"><i class="bi bi-github"></i> GitHub</a>` : ''}
                                ${p.liveDemoLink ? `<a href="${p.liveDemoLink}" target="_blank" class="text-decoration-none small"><i class="bi bi-box-arrow-up-right"></i> Live Demo</a>` : ''}
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-sm btn-outline-primary" onclick="editProject(${p.id})"><i class="bi bi-pencil"></i> Edit</button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteProject(${p.id})"><i class="bi bi-trash"></i> Delete</button>
                        </div>
                    </div>
                </div>
            `).join("");
        } catch (error) {
            showToast("Error loading projects", "danger");
        }
    }

    window.openProjectModal = (id = null) => {
        // Reset arrays
        currentSkills = [];
        currentFeatures = [];
        renderSkills();
        renderFeatures();
        
        document.getElementById("projectForm").reset();
        document.getElementById("projectId").value = "";
        document.getElementById("projectPreview").innerHTML = "";
        document.getElementById("newSkillInput").value = "";
        document.getElementById("newFeatureInput").value = "";
        
        if (id) editProject(id);
    };
    
    window.editProject = async (id) => {
        try {
            const res = await apiFetch(`Projects/${id}`);
            if (!res.ok) throw new Error("Failed to load project");
            const p = await res.json();
            
            document.getElementById("projectId").value = p.id;
            document.getElementById("projName").value = p.name;
            document.getElementById("projDesc").value = p.description;
            document.getElementById("projGithub").value = p.githubLink || "";
            document.getElementById("projDemo").value = p.liveDemoLink || "";
            
            // Load skills and features into arrays
            currentSkills = p.skills || [];
            currentFeatures = p.features || [];
            renderSkills();
            renderFeatures();
            
            if (p.imageUrl) {
                document.getElementById("projectPreview").innerHTML = `<img src="${p.imageUrl}" class="image-upload-preview" alt="Current image">`;
            }
            
            new bootstrap.Modal(document.getElementById("projectModal")).show();
        } catch (error) {
            showToast("Error loading project", "danger");
        }
    };
    
    window.saveProject = async () => {
        const id = document.getElementById("projectId").value;
        const formData = new FormData();
        formData.append("Name", document.getElementById("projName").value);
        formData.append("Skills", JSON.stringify(currentSkills));
        formData.append("Features", JSON.stringify(currentFeatures));
        formData.append("Description", document.getElementById("projDesc").value);
        formData.append("GithubLink", document.getElementById("projGithub").value || "");
        formData.append("LiveDemoLink", document.getElementById("projDemo").value || "");
        
        const fileInput = document.getElementById("projImage");
        if (fileInput.files[0]) formData.append("image", fileInput.files[0]);
        
        const url = id ? `Projects/${id}` : "Projects";
        const method = id ? "PUT" : "POST";
        
        try {
            const res = await fetch(`${API_BASE}${url}`, {
                method,
                headers: { "Authorization": `Bearer ${AUTH_TOKEN}` },
                body: formData
            });
            
            if (!res.ok) {
                const errorData = await res.json();
                throw new Error(errorData.message || "Failed to save project");
            }
            showToast(`Project ${id ? "updated" : "created"} successfully!`);
            bootstrap.Modal.getInstance(document.getElementById("projectModal")).hide();
            await loadProjects();
        } catch (error) {
            showToast("Error saving project: " + error.message, "danger");
        }
    };
    
    window.deleteProject = async (id) => {
        if (confirm("Are you sure you want to delete this project?")) {
            try {
                const res = await apiFetch(`Projects/${id}`, { method: "DELETE" });
                if (!res.ok) throw new Error("Failed to delete");
                showToast("Project deleted successfully!");
                await loadProjects();
            } catch (error) {
                showToast("Error deleting project", "danger");
            }
        }
    };

    // EXPERIENCES CRUD
    async function loadExperiences() {
        try {
            const res = await apiFetch("Experiences");
            if (!res.ok) throw new Error("Failed to load experiences");
            const exps = await res.json();
            const container = document.getElementById("experiencesList");
            
            if (exps.length === 0) {
                container.innerHTML = `<div class="text-center py-5"><i class="bi bi-briefcase fs-1 text-muted"></i><p class="text-muted mt-2">No experiences yet. Click "Add Experience" to add one.</p></div>`;
                return;
            }
            
            container.innerHTML = exps.map(e => `
                <div class="card-dashboard card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="fw-bold mb-1">${escapeHtml(e.jobTitle)}</h5>
                                <h6 class="text-muted">${escapeHtml(e.company)}</h6>
                                <small class="text-secondary">${escapeHtml(e.date)}</small>
                                <div class="mt-3">
                                    <strong>Key Responsibilities & Achievements:</strong>
                                    <ul class="bullet-list mt-2">
                                        ${e.bulletPoints && e.bulletPoints.length > 0 
                                            ? e.bulletPoints.map(bp => `<li>${escapeHtml(bp)}</li>`).join('')
                                            : '<li>No details provided</li>'}
                                    </ul>
                                </div>
                            </div>
                            <div class="ms-3">
                                <button class="btn btn-sm btn-outline-warning me-1" onclick="editExperience(${e.id})"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteExperience(${e.id})"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            `).join("");
        } catch (error) {
            showToast("Error loading experiences", "danger");
        }
    }
    
    window.openExperienceModal = () => {
        currentBulletPoints = [];
        renderBulletPoints();
        
        document.getElementById("expId").value = "";
        document.getElementById("expJobTitle").value = "";
        document.getElementById("expCompany").value = "";
        document.getElementById("expDate").value = "";
        document.getElementById("newBulletPointInput").value = "";
    };
    
    window.editExperience = async (id) => {
        try {
            const res = await apiFetch(`Experiences/${id}`);
            if (!res.ok) throw new Error("Failed to load experience");
            const e = await res.json();
            
            document.getElementById("expId").value = e.id;
            document.getElementById("expJobTitle").value = e.jobTitle;
            document.getElementById("expCompany").value = e.company;
            document.getElementById("expDate").value = e.date;
            
            // Load bullet points into array
            currentBulletPoints = e.bulletPoints || [];
            renderBulletPoints();
            
            new bootstrap.Modal(document.getElementById("experienceModal")).show();
        } catch (error) {
            showToast("Error loading experience", "danger");
        }
    };
    
    window.saveExperience = async () => {
        const id = document.getElementById("expId").value;
        
        const payload = {
            jobTitle: document.getElementById("expJobTitle").value,
            company: document.getElementById("expCompany").value,
            date: document.getElementById("expDate").value,
            bulletPoints: currentBulletPoints
        };
        
        const url = id ? `Experiences/${id}` : "Experiences";
        const method = id ? "PUT" : "POST";
        
        try {
            let res;
            if (id) {
                res = await apiFetch(url, { method, body: JSON.stringify({ ...payload, id }) });
            } else {
                res = await apiFetch(url, { method, body: JSON.stringify(payload) });
            }
            
            if (!res.ok) {
                const errorData = await res.json();
                throw new Error(errorData.message || "Failed to save experience");
            }
            showToast(`Experience ${id ? "updated" : "added"} successfully!`);
            bootstrap.Modal.getInstance(document.getElementById("experienceModal")).hide();
            await loadExperiences();
        } catch (error) {
            showToast("Error saving experience: " + error.message, "danger");
        }
    };
    
    window.deleteExperience = async (id) => {
        if (confirm("Delete this experience?")) {
            try {
                const res = await apiFetch(`Experiences/${id}`, { method: "DELETE" });
                if (!res.ok) throw new Error("Failed to delete");
                showToast("Experience deleted successfully!");
                await loadExperiences();
            } catch (error) {
                showToast("Error deleting experience", "danger");
            }
        }
    };

    // TESTIMONIALS CRUD
    async function loadTestimonials() {
        try {
            const res = await apiFetch("Testimonials");
            if (!res.ok) throw new Error("Failed to load testimonials");
            const tests = await res.json();
            const container = document.getElementById("testimonialsList");
            
            if (tests.length === 0) {
                container.innerHTML = `<div class="text-center py-5"><i class="bi bi-chat-dots fs-1 text-muted"></i><p class="text-muted mt-2">No testimonials yet. Click "Add Testimonial" to add one.</p></div>`;
                return;
            }
            
            container.innerHTML = tests.map(t => `
                <div class="card-dashboard card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    ${t.clientImageUrl ? `<img src="${t.clientImageUrl}" class="rounded-circle" width="50" height="50" style="object-fit:cover;">` : `<div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width:50px;height:50px;"><i class="bi bi-person text-white"></i></div>`}
                                    <div>
                                        <h5 class="fw-bold mb-1">${escapeHtml(t.clientName)}</h5>
                                        <div class="rating-stars">${"★".repeat(t.rating)}${"☆".repeat(5 - t.rating)}</div>
                                    </div>
                                </div>
                                <p class="mb-0 mt-2">"${escapeHtml(t.text)}"</p>
                                <small class="text-muted mt-2 d-block">${new Date(t.createdAt).toLocaleDateString()}</small>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-warning me-1" onclick="editTestimonial(${t.id})"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteTestimonial(${t.id})"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            `).join("");
        } catch (error) {
            showToast("Error loading testimonials", "danger");
        }
    }
    
    window.openTestimonialModal = () => {
        document.getElementById("testId").value = "";
        document.getElementById("clientName").value = "";
        document.getElementById("testText").value = "";
        document.getElementById("testRating").value = "5";
        document.getElementById("testimonialPreview").innerHTML = "";
        document.getElementById("testImage").value = "";
    };
    
    window.editTestimonial = async (id) => {
        try {
            const res = await apiFetch(`Testimonials/${id}`);
            if (!res.ok) throw new Error("Failed to load testimonial");
            const t = await res.json();
            document.getElementById("testId").value = t.id;
            document.getElementById("clientName").value = t.clientName;
            document.getElementById("testText").value = t.text;
            document.getElementById("testRating").value = t.rating;
            if (t.clientImageUrl) {
                document.getElementById("testimonialPreview").innerHTML = `<img src="${t.clientImageUrl}" class="image-upload-preview" alt="Current image">`;
            }
            new bootstrap.Modal(document.getElementById("testimonialModal")).show();
        } catch (error) {
            showToast("Error loading testimonial", "danger");
        }
    };
    
    window.saveTestimonial = async () => {
        const id = document.getElementById("testId").value;
        const formData = new FormData();
        formData.append("ClientName", document.getElementById("clientName").value);
        formData.append("Text", document.getElementById("testText").value);
        formData.append("Rating", document.getElementById("testRating").value);
        
        const fileInput = document.getElementById("testImage");
        if (fileInput.files[0]) formData.append("image", fileInput.files[0]);
        
        const url = id ? `Testimonials/${id}` : "Testimonials";
        const method = id ? "PUT" : "POST";
        
        try {
            const res = await fetch(`${API_BASE}${url}`, {
                method,
                headers: { "Authorization": `Bearer ${AUTH_TOKEN}` },
                body: formData
            });
            
            if (!res.ok) throw new Error("Failed to save testimonial");
            showToast(`Testimonial ${id ? "updated" : "added"} successfully!`);
            bootstrap.Modal.getInstance(document.getElementById("testimonialModal")).hide();
            await loadTestimonials();
        } catch (error) {
            showToast("Error saving testimonial", "danger");
        }
    };
    
    window.deleteTestimonial = async (id) => {
        if (confirm("Delete this testimonial?")) {
            try {
                const res = await apiFetch(`Testimonials/${id}`, { method: "DELETE" });
                if (!res.ok) throw new Error("Failed to delete");
                showToast("Testimonial deleted successfully!");
                await loadTestimonials();
            } catch (error) {
                showToast("Error deleting testimonial", "danger");
            }
        }
    };

    // MESSAGES CRUD
    async function loadMessages() {
        try {
            const res = await apiFetch("ContactMessages");
            if (!res.ok) throw new Error("Failed to load messages");
            const msgs = await res.json();
            const container = document.getElementById("messagesList");
            
            if (msgs.length === 0) {
                container.innerHTML = `<div class="text-center py-5"><i class="bi bi-inbox fs-1 text-muted"></i><p class="text-muted mt-2">No messages yet.</p></div>`;
                return;
            }
            
            container.innerHTML = msgs.map(m => `
                <div class="card-dashboard card mb-3 message-card ${!m.isRead ? 'message-unread' : ''}" onclick="viewMessage(${m.id}, ${!m.isRead})">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <strong>${escapeHtml(m.name)}</strong>
                                    <span class="text-muted small">&lt;${escapeHtml(m.email)}&gt;</span>
                                    ${!m.isRead ? '<span class="badge bg-primary badge-read">New</span>' : ''}
                                </div>
                                <h6 class="mb-2">${escapeHtml(m.subject)}</h6>
                                <p class="text-muted small mb-1">${escapeHtml(m.message.substring(0, 100))}${m.message.length > 100 ? '...' : ''}</p>
                                <small class="text-muted"><i class="bi bi-clock"></i> ${new Date(m.createdAt).toLocaleString()}</small>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteMessage(${m.id})"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            `).join("");
        } catch (error) {
            showToast("Error loading messages", "danger");
        }
    }
    
    window.refreshMessages = () => {
        loadMessages();
    };
    
    window.viewMessage = async (id, markAsRead = true) => {
        try {
            const res = await apiFetch(`ContactMessages/${id}`);
            if (!res.ok) throw new Error("Failed to load message");
            const msg = await res.json();
            
            if (markAsRead && !msg.isRead) {
                await apiFetch(`ContactMessages/${id}/read`, { method: "PUT" });
                await loadMessages();
                msg.isRead = true;
            }
            
            currentMessageId = id;
            const detailHtml = `
                <h5 class="mb-3">From: ${escapeHtml(msg.name)}</h5>
                <p><strong>Email:</strong> <a href="mailto:${escapeHtml(msg.email)}">${escapeHtml(msg.email)}</a></p>
                <p><strong>Subject:</strong> ${escapeHtml(msg.subject)}</p>
                <p><strong>Date:</strong> ${new Date(msg.createdAt).toLocaleString()}</p>
                <hr>
                <p><strong>Message:</strong></p>
                <p class="p-3 bg-light rounded">${escapeHtml(msg.message)}</p>
                <div class="mt-3">
                    <button class="btn btn-sm btn-outline-success" onclick="window.location.href='mailto:${escapeHtml(msg.email)}'">
                        <i class="bi bi-reply"></i> Reply via Email
                    </button>
                </div>
            `;
            document.getElementById("messageDetailContent").innerHTML = detailHtml;
            new bootstrap.Modal(document.getElementById("messageModal")).show();
        } catch (error) {
            showToast("Error loading message details", "danger");
        }
    };
    
    window.deleteMessage = async (id = null) => {
        const messageId = id || currentMessageId;
        if (confirm("Delete this message?")) {
            try {
                const res = await apiFetch(`ContactMessages/${messageId}`, { method: "DELETE" });
                if (!res.ok) throw new Error("Failed to delete");
                showToast("Message deleted successfully!");
                bootstrap.Modal.getInstance(document.getElementById("messageModal"))?.hide();
                await loadMessages();
            } catch (error) {
                showToast("Error deleting message", "danger");
            }
        }
    };

    function escapeHtml(str) {
        if (!str) return "";
        return str.replace(/[&<>]/g, function(m) {
            if (m === "&") return "&amp;";
            if (m === "<") return "&lt;";
            if (m === ">") return "&gt;";
            return m;
        });
    }

    // Set live date
    document.getElementById("liveDate").innerText = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    
    // Check authentication on load
    if (AUTH_TOKEN) {
        document.getElementById("loginPage").style.display = "none";
        document.getElementById("dashboardWrapper").style.display = "block";
        loadDashboardContent("projects");
    } else {
        document.getElementById("dashboardWrapper").style.display = "none";
        document.getElementById("loginPage").style.display = "flex";
    }
</script>
